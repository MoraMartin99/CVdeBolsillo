{
  "plugins": ["plugins/markdown"],
  "source": {
    "include": ["./src", "./plugins"],
    "includePattern": ".+\\.jsx{0,1}$",
    "excludePattern": "(node_modules|docs)"
  },
  "opts": {
    "destination": "./doc/",
    "recurse": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  }
}
